# Public API origin (NestJS backend). Never commit real secrets here.
NUXT_ENV_BASE_URL=http://localhost:3000

# Production site URL (used by security:dast header checks)
NUXT_PUBLIC_SITE_URL=http://localhost:8000

# Max payment screenshot upload size in bytes (client-side guard)
NUXT_PUBLIC_PAYMENT_SCREENSHOT_MAX_BYTES=409600

# --- Playwright E2E (copy to .env.local / export in shell; never commit passwords) ---
# Frontend under test (defaults match nuxt.devServer)
E2E_BASE_URL=http://localhost:8000
# Set to 1 if Nuxt is already running (skips playwright webServer)
# E2E_SKIP_WEBSERVER=1

# Role credentials — must match seeded backend users (demo emails on login UI)
E2E_ADMIN_EMAIL=admin@library.local
E2E_ADMIN_PASSWORD=

E2E_EMPLOYEE_EMAIL=employee1@library.local
E2E_EMPLOYEE_PASSWORD=

# Optional second branch employee (cross-branch isolation EMP-E2E-03)
# E2E_EMPLOYEE2_EMAIL=employee2@library.local
# E2E_EMPLOYEE2_PASSWORD=

E2E_CS_EMAIL=cs@library.local
E2E_CS_PASSWORD=

# Optional fixtures when UI catalog search is ambiguous
# E2E_STUDENT_SEARCH=
# E2E_PRODUCT_SEARCH=
# E2E_PRODUCT_OUT_OF_STOCK_SEARCH=

# Watch mode: E2E_HEADED=1 E2E_SLOW_MO=1000 npm run test:e2e:watch -- e2e/stories
