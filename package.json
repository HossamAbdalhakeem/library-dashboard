    "@nuxtjs/sitemap": "^8.5.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^1.0.2",
    "@primevue/themes": "^4.4.1",
    "@supabase/supabase-js": "^2.116.0",
    "@vee-validate/nuxt": "^4.14.7",
    "@vee-validate/rules": "^4.14.7",
    "better-sqlite3": "^12.11.1",
    "chart.js": "^4.5.1",
    "cropperjs": "^1.6.3",
    "eslint": "^10.9.1",
