    "primevue": "^4.4.1",
    "shaka-player": "^5.2.8",
    "vue": "^3.5.41",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.2.0",
    "vue-tel-input": "^9.8.0"
  },
  "devDependencies": {
