{
  "name": "test2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "E2E_HEADED=1 playwright test --headed",
    "test:e2e:watch": "E2E_HEADED=1 E2E_SLOW_MO=1000 E2E_SKIP_WEBSERVER=1 playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "security:sca": "npm audit --omit=dev --audit-level=high",
    "security:sast": "eslint -c eslint.security.config.mjs . --max-warnings 0",
    "security:dast": "node scripts/security-dast.mjs",
    "security:check": "npm run security:sca && npm run security:sast && npm run security:dast"
  },
  "dependencies": {
    "@nuxt/content": "^3.15.2",
    "@nuxt/eslint": "^1.17.0",
